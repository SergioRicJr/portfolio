{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:deploy": "node --test tests/worker.test.mjs && python -m unittest discover -s tests -p test_*.py",
    "worker:dev": "wrangler dev --config infra/cloudflare/wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config infra/cloudflare/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config infra/cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.6",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.6",
    "lucide-react": "^0.378.0",
    "maath": "^0.10.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.4",
    "react-intersection-observer": "^9.10.2",
    "react-scroll": "^1.9.0",
    "tailwind-merge": "^2.3.0",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-scroll": "^1.8.10",
    "@types/three": "^0.164.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.2.11",
    "wrangler": "^4.151.1"
  }
